{
  "name": "kid-princess-three",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5182 --strictPort",
    "build": "node scripts/check-spelling.mjs && node scripts/audio-lines.mjs --check && tsc --noEmit && vite build",
    "preview": "vite preview --host --port 5182",
    "check:spelling": "node scripts/check-spelling.mjs",
    "check:audio": "node scripts/audio-lines.mjs --check",
    "audio": "node scripts/audio-lines.mjs && scripts/.venv/bin/python scripts/gen-audio.py",
    "test:human": "node scripts/test/play-human.mjs",
    "test:perf": "node scripts/test/perf.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4",
    "@gltf-transform/extensions": "4",
    "@gltf-transform/functions": "4",
    "@types/three": "0.186.0",
    "meshoptimizer": "^1.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
